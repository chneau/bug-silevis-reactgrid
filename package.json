{
	"name": "silevis-reactgrid-example",
	"scripts": {
		"start": "rsbuild dev",
		"dev": "rsbuild dev",
		"all": "bun run upgrade; bun run check; bun run lint",
		"upgrade": "bun update --latest",
		"check": "deno fmt --use-tabs --quiet; oxlint --fix-dangerously --quiet; biome check --write --unsafe .",
		"lint": "tsc"
	},
	"dependencies": {
		"@silevis/reactgrid": "^4.1.12",
		"dayjs": "^1.11.13",
		"normalize.css": "^8.0.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@rsbuild/core": "^1.0.19",
		"@rsbuild/plugin-react": "^1.0.6",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"oxlint": "^0.11.0",
		"typescript": "^5.6.3"
	}
}
